<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Free User Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=SF+Pro+Display:wght@400;600;700&display=swap" rel="stylesheet">
<style>
/* ========== Global Styles ========== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: 'SF Pro Display', sans-serif;
    transition: all 0.3s ease;
}

body {
    min-height: 100vh;
    background: url('background.jpg') center/cover no-repeat fixed;
    display: flex;
    flex-direction: column;
    align-items: center;
    color: #000;
}

.dashboard-container {
    margin-top: 50px;
    width: 90%;
    max-width: 1000px;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(25px);
    border-radius: 25px;
    padding: 40px;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4);
    animation: fadeIn 0.8s ease forwards;
    position: relative;
    z-index: 2;
}

/* ========== Sidebar ========== */
.sidebar {
    position: fixed;
    top: 0;
    left: -300px;
    width: 250px;
    height: 100%;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(20px);
    color: black;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    padding: 50px 15px 10px 15px;
    box-shadow: 2px 0 10px rgba(0, 0, 0, 0.2);
    transition: left 0.3s ease;
    z-index: 4;
}

.sidebar a {
    text-decoration: none;
    color: black;
    font-size: 1.2rem;
    margin: 8px 0;
    padding: 10px;
    border-radius: 5px;
    transition: background-color 0.3s, opacity 0.3s, transform 0.3s;
    display: flex;
    align-items: center;
    opacity: 0;
    transform: translateX(-20px);
}

.sidebar a .icon {
    margin-right: 10px;
    font-size: 1.5rem;
}

.sidebar a:hover {
    background-color: #005bb5;
    color: #fff;
}

.sidebar.active {
    left: 0;
}

.sidebar.active a {
    opacity: 1;
    transform: translateX(0);
}

/* ========== Overlay & Content Lock ========== */
.overlay,
.content-lock {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: none;
}

.overlay.active {
    display: block;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 3;
}

.content-lock.active {
    display: block;
    background: transparent;
    cursor: not-allowed;
    z-index: 2;
}

/* ========== Hamburger ========== */
.hamburger {
    position: fixed;
    top: 15px;
    left: 15px;
    width: 50px;
    height: 50px;
    background: #fff;
    border-radius: 10px;
    box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    z-index: 5;
    transition: 0.3s;
}

.hamburger div {
    width: 30px;
    height: 4px;
    background-color: #007aff;
    margin: 4px 0;
    transition: 0.3s;
}

.hamburger.active div:nth-child(1) {
    transform: rotate(-45deg) translate(-5px, 6px);
}

.hamburger.active div:nth-child(2) {
    opacity: 0;
}

.hamburger.active div:nth-child(3) {
    transform: rotate(45deg) translate(-5px, -6px);
}

/* ========== Menu Grid ========== */
.menu-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 30px;
}

.menu-box {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(15px);
    padding: 30px 0;
    text-align: center;
    border-radius: 15px;
    cursor: pointer;
    font-size: 1.5rem;
    font-weight: 600;
    transition: 0.4s;
    border: 2px solid rgba(0, 0, 0, 0.3);
}

.menu-box.active {
    background: rgba(0, 122, 255, 0.7);
    color: #fff;
    border: 2px solid rgba(0, 122, 255, 0.8);
    box-shadow: 0 0 30px rgba(0, 122, 255, 0.8);
}

.menu-box:hover {
    transform: translateY(-5px) scale(1.05);
    box-shadow: 0 0 25px rgba(0, 255, 255, 0.6);
}

/* ========== Post List ========== */
.post-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
    margin-top: 20px;
    opacity: 0;
    transform: translateY(20px);
    transition: 0.5s;
}

.post-list.show {
    opacity: 1;
    transform: translateY(0);
}

.post-item {
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    padding: 20px;
    border-radius: 15px;
    transition: 0.3s;
    border: 2px solid rgba(0, 0, 0, 0.2);
    cursor: pointer;
}

.post-item:hover {
    transform: translateY(-5px) scale(1.02);
    box-shadow: 0 0 20px rgba(0, 122, 255, 0.6);
}

.post-item h3 {
    margin-bottom: 10px;
}

.post-item p {
    font-size: 0.9rem;
    color: #111;
}

/* ========== Search ========== */
.search-container {
    margin-top: 20px;
    width: 100%;
    text-align: center;
    display: none;
}

.search-container input {
    padding: 10px;
    font-size: 1rem;
    border-radius: 10px;
    border: 1px solid #ccc;
    width: 50%;
    transition: all 0.3s ease;
}

.search-container input:focus {
    border-color: #007aff;
    box-shadow: 0 0 10px rgba(0, 122, 255, 0.6);
}

/* ========== Back Button ========== */
.back-btn {
    margin-top: 20px;
    padding: 10px 20px;
    background: #007aff;
    color: #fff;
    border: none;
    border-radius: 15px;
    cursor: pointer;
    display: none;
}

.back-btn:hover {
    background: #005bb5;
    transform: scale(1.05);
}

/* ========== Animations ========== */
@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
</style>
</head>
<body>

<!-- Sidebar -->
<div class="sidebar" id="sidebar">
    <a href="utama.html"><span class="icon">🏡</span> Home</a>
    <a href="user.html"><span class="icon">👥</span> User</a>
    <a href="admin.html"><span class="icon">👤</span> Admin</a>
    <a href="help.html"><span class="icon">❓</span> Help</a>
    <a href="support.html"><span class="icon">💬</span> Support</a>
</div>

<!-- Overlay & Content Lock -->
<div class="overlay" id="overlay"></div>
<div class="content-lock" id="contentLock"></div>

<!-- Hamburger -->
<div class="hamburger" id="hamburger" onclick="toggleSidebar()">
    <div></div>
    <div></div>
    <div></div>
</div>

<!-- Dashboard Container -->
<div class="dashboard-container" id="dashboardContainer">
    <h2 id="dashboardTitle" style="text-align:center; margin-bottom:30px;">📌 Free User Dashboard</h2>

    <!-- Category Boxes -->
    <div class="menu-grid" id="categoryBoxes">
        <div class="menu-box" onclick="filterPosts('A')">A</div>
        <div class="menu-box" onclick="filterPosts('B')">B</div>
        <div class="menu-box" onclick="filterPosts('C')">C</div>
        <div class="menu-box" onclick="filterPosts('D')">D</div>
        <div class="menu-box" onclick="filterPosts('E')">E</div>
        <div class="menu-box" onclick="filterPosts('F')">F</div>
    </div>

    <!-- Search -->
    <div class="search-container" id="searchContainer">
        <input type="text" id="searchInput" placeholder="Cari Postingan..." onkeyup="searchPosts()">
    </div>

    <!-- Post List -->
    <div class="post-list" id="postList"></div>

    <!-- Back Button -->
    <button class="back-btn" id="backButton" onclick="backToCategories()">← Kembali ke Kategori</button>
</div>

<footer>&copy; 2026 @nipo Free Edition</footer>

<script>
let posts = JSON.parse(localStorage.getItem('posts')) || [];
let currentCategory = null;

function renderPosts(postArray) {
    const postList = document.getElementById('postList');
    postList.innerHTML = '';
    if (postArray.length === 0) {
        postList.innerHTML = '<p>Belum ada postingan di kategori ini.</p>';
        return;
    }
    postArray.forEach(post => {
        const div = document.createElement('div');
        div.classList.add('post-item');
        div.innerHTML = `<h3>${post.title}</h3><p>${post.content}</p>`;
        div.onclick = () => window.location.href = `post_detail.html?title=${encodeURIComponent(post.title)}`;
        postList.appendChild(div);
    });
    postList.classList.add('show');
}

function toggleSidebar() {
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('overlay');
    const lock = document.getElementById('contentLock');
    const hamburger = document.getElementById('hamburger');
    const active = sidebar.classList.toggle('active');
    overlay.classList.toggle('active');
    lock.classList.toggle('active');
    hamburger.classList.toggle('active');
}

document.getElementById('overlay').onclick = () => toggleSidebar();

function filterPosts(category) {
    currentCategory = category;
    document.getElementById('categoryBoxes').style.display = 'none';
    const filtered = posts.filter(p => p.category === category);
    renderPosts(filtered);
    document.getElementById('backButton').style.display = 'inline-block';
    document.getElementById('searchContainer').style.display = 'block';
    document.getElementById('dashboardTitle').textContent = `📌 ${category} Posts`;
}

function backToCategories() {
    document.getElementById('categoryBoxes').style.display = 'grid';
    document.getElementById('backButton').style.display = 'none';
    document.getElementById('searchContainer').style.display = 'none';
    document.getElementById('dashboardTitle').textContent = '📌 Free User Dashboard';
    document.getElementById('postList').innerHTML = '';
}

function searchPosts() {
    const query = document.getElementById('searchInput').value.toLowerCase();
    const filteredPosts = posts.filter(post =>
        post.category === currentCategory &&
        (post.title.toLowerCase().includes(query) || post.content.toLowerCase().includes(query))
    );
    renderPosts(filteredPosts);
}
</script>
</body>
</html>